# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Environment / secrets (never commit real env files) ----
.env
.env.*
!.env.example

# ---- Test / type / lint caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---- Tooling / editors ----
.idea/
# Ignore editor dirs but keep shared project settings so IDE mirrors the Docker env.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# ---- OS junk (relevant for pendrive transfer) ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Docker / local data ----
*.log
pgdata/
postgres-data/
redis-data/
