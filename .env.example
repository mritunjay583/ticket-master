# Copy to .env for local overrides:  cp .env.example .env
# The real .env is gitignored and must NEVER be committed.
#
# Two audiences read these:
#   1. Docker Compose (docker-compose.yml) — for the db + api container wiring.
#   2. The app's Settings class (app/core/config.py) — when running bare-metal.
# All values below are LOCAL-DEV defaults. Production values come from the platform's
# secret manager and are never stored in files committed to git.

# --- Postgres container (read by docker-compose.yml) ---
POSTGRES_USER=ticketmaster
POSTGRES_PASSWORD=ticketmaster
POSTGRES_DB=ticketmaster
DB_PORT=5432
API_PORT=8000

# --- App (read by Settings; docker-compose passes these to the api container) ---
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO

# Inside Docker the DB host is the service name `db`; bare-metal it's `localhost`.
DATABASE_URL=postgresql+psycopg://ticketmaster:ticketmaster@db:5432/ticketmaster
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO=false

# --- Queue (used from Phase 3 onward) ---
REDIS_URL=redis://redis:6379/0
QUEUE_BACKEND=rq
QUEUE_NAME=tickets
